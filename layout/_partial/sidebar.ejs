<div class="site-sidebar">
	<div class="sidebar-ambiance" aria-hidden="true">
		<span class="shape shape-1"></span>
		<span class="shape shape-2"></span>
		<span class="shape shape-3"></span>
		<span class="shape shape-4"></span>
		<span class="shape shape-5"></span>
	</div>
	<div class="sidebar-frost" aria-hidden="true"></div>

	<div class="sidebar-inner">
	<%
		var toc_html = '';
		if ((is_post() || is_page()) && post.toc === true) {
			toc_html = toc(post.content);
		}
		var display_toc = !!(toc_html && String(toc_html).trim());
	%>
	
	<div class="sidebar-switch clearfix <%- display_toc ? 'show' : '' %>"
		style="display: <%- display_toc ? 'block' : 'none' %>">
		<a class="dark-btn active" data-toggle="toc">
	    <span class="icon icon-list"></span>
	    <span class="text">Index</span>
	  </a>
	  <a class="dark-btn" data-toggle="bio">
	    <span class="icon icon-person"></span>
	    <span class="text">Bio</span>
	  </a>
	</div>

	<div class="site-toc <%- display_toc ? 'show' : '' %>"
		style="display: <%- display_toc ? 'block' : 'none' %>">
		<% if (display_toc) { %>
	  	<%- toc_html %>
	  <% } %>
  </div>
  
	<div class="site-bio <%- display_toc ? '' : 'show' %>"
		style="display: <%- display_toc ? 'none' : 'block' %>">
		
	  <!-- About Me -->
	  <div class="about-me clearfix">
	    <div class="avatar">
	      <picture>
	        <source srcset="<%- url_for('/img/avatar.webp') %>" type="image/webp">
	        <img
	          class="avatar-img is-placeholder"
	          src="<%- url_for('/img/avatar.jpg') %>"
	          data-full-src="<%- url_for(theme.author_avatar) %>"
	          width="96"
	          height="96"
	          alt="<%= config.author %>"
	          decoding="async"
	        />
	      </picture>
	    </div>
	    <div class="info">
	      <a class="name dark-btn" href="<%- url_for() %>about">
	        <%- config.author %>
	      </a>
	    </div>
	    <div class="info">
	      <span class="item desc">
	        <%- config.description %>
	      </span>
	    </div>
	  </div>
	
	  <!-- Social Icons -->
	  <div class="social clearfix">
	    <% if (theme.social) { %>
	      <% theme.social.forEach(function(value, key) {
	           if (value.url && value.name) { %>
	        <a href="<%= url_for(value.url) %>" class="<%= value.name %>"
	          target="_blank" rel="external">
	          <span class="icon icon-<%= value.icon || value.name %>"></span>
	        </a>
	      <% } }); %>
	    <% } %>
	  </div>
	
	  <!-- Home & Bottom -->
	  <div class="shortcuts clearfix">
	    <div class="bk">
	      <a href="#header" class="dark-btn window-nav">
	        <span class="icon icon-chevron-thin-up"></span>
	        <span class="text">Back to Top</span>
	      </a>
	    </div>
	    <div class="bk">
	      <a href="#footer" class="dark-btn window-nav">
	        <span class="icon icon-chevron-thin-down"></span>
	        <span class="text">Go to Bottom</span>
	      </a>
	    </div>
	  </div>

	</div>
	</div>

</div>
